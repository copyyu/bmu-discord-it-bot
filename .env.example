# PostgreSQL connection string (Railway: Database → Connect → Public Network)
# รูปแบบ: postgresql://USER:PASS@HOST:PORT/DBNAME
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Discord webhook สำหรับ IT Tickets (จำเป็น)
# Channel Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_IT_TICKET=https://discord.com/api/webhooks/.../...

# Discord webhook สำหรับ Equipment Borrowings (ไม่บังคับ — เว้นว่างเพื่อปิด feature นี้)
# สร้าง webhook ใน channel คนละช่องจาก IT tickets
DISCORD_WEBHOOK_EQUIPMENT=

# Discord webhook สำหรับ Check-in/out (ไม่บังคับ — เว้นว่างเพื่อปิด feature นี้)
# สร้าง webhook ใน channel แยกอีกช่อง
DISCORD_WEBHOOK_CHECKIN=

# Discord webhook สำหรับ Error Log (System Status → "บันทึกข้อผิดพลาด") (ไม่บังคับ)
# แจ้งเตือนเมื่อ backend เกิด error (500 / uncaughtException / unhandledRejection)
# แนะนำให้สร้าง webhook ใน channel แยก (เช่น #it-errors) — เว้นว่างเพื่อปิด
DISCORD_WEBHOOK_ERROR_LOG=

# Optional: ping ตอนมี error (default '' = ไม่ ping). ใส่ @everyone หรือ <@&ROLE_ID> เพื่อเปิด
# ERROR_LOG_MENTION=
# Optional: แจ้งเฉพาะ level ที่ระบุ (คั่น comma) เช่น "error,fatal" — ว่าง = ทุก level
# ERROR_LOG_LEVELS=
# Optional: ระงับ error ตัวเดิม (level+category+code+message) ที่ซ้ำภายใน N วินาที (default 60)
# ERROR_LOG_DEDUP_SEC=60
# Optional: จำกัดจำนวน error ที่โพสต์ต่อนาที กัน flood (default 15, Discord limit ~30/นาที)
# ERROR_LOG_MAX_PER_MIN=15

# Discord webhook สำหรับ API error ตามพนักงาน (System Status → "การเรียก API ที่ error ตามพนักงาน") (ไม่บังคับ)
# แจ้งเมื่อพนักงานเรียก API แล้ว error (4xx/5xx) — แนะนำ channel แยก — เว้นว่างเพื่อปิด
DISCORD_WEBHOOK_API_ERROR=

# Optional: ping ตอนมี API error (default '' = ไม่ ping)
# API_ERROR_MENTION=
# Optional: แจ้งเฉพาะ status_code >= ค่านี้ (default 500 = เฉพาะ 5xx; ตั้ง 400 เพื่อรวม 4xx)
# ⚠️ 4xx (401/403/400) เกิดบ่อยมาก — ตั้ง 400 แล้วอาจ spam (มี dedup/cap ช่วย แต่ระวัง)
# API_ERROR_MIN_STATUS=500
# Optional: ระงับ user+method+endpoint+status เดิมซ้ำภายใน N วินาที (default 300 = 5 นาที)
# API_ERROR_DEDUP_SEC=300
# Optional: จำกัดจำนวน API error ที่โพสต์ต่อนาที (default 10)
# API_ERROR_MAX_PER_MIN=10

# รายชื่อ username ที่จะแจ้งเตือนตอนเช็คอิน/เอาท์ (คั่นด้วย comma) — ว่าง = ไม่แจ้งใครเลย
# เปลี่ยนรายชื่อที่นี่ได้เลย ไม่ต้องรัน SQL ใหม่
CHECKIN_USERNAMES=Siraphob.pat,Chayapol.jit,mossit,Yuttana.wis,Taechit.suw,kenshiro

# Optional: mention ตอน check-in (default '' = ไม่ ping — กัน spam เพราะวันละหลายสิบครั้ง)
# CHECKIN_MENTION=

# Optional: override displayed bot name (default "BMU IT Bot")
# BOT_NAME=BMU IT Bot

# Optional: mention ที่จะใช้ (default '@everyone'; '@here' / '<@&ROLE_ID>' / '' เพื่อปิด)
# MENTION=@everyone

# Optional: ms to wait before reconnect on DB drop (default 5000)
# RECONNECT_DELAY_MS=5000
